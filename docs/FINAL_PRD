from filterpy.kalman import UnscentedKalmanFilter as FilterPyUKF
from filterpy.common import Q_discrete_white_noise

class NarrativeUKF:
    """
    Optimal nonlinear state estimator for NarrativeStateVector.

    Why UKF not vanilla Kalman (from brutal critique):
    Vanilla Kalman assumes linear state transitions and Gaussian noise.
    Human narrative is nonlinear — a trauma disclosure mid-session
    is a genuine state discontinuity, not a measurement outlier.
    Vanilla Kalman smooths it out incorrectly as noise.
    UKF uses sigma points to propagate uncertainty through the
    nonlinear function without linearization — handles discontinuities.

    Why not EKF:
    EKF linearizes via Jacobians — works for mild nonlinearity.
    Narrative transitions can be severely nonlinear.
    UKF is more robust across the full range of possible state jumps.

    Implementation: filterpy.kalman.UnscentedKalmanFilter
    """

    def __init__(self, state_dim: int):
        self.state_dim = state_dim
        self.ukf = FilterPyUKF(
            dim_x=state_dim,
            dim_z=state_dim,
            dt=1.0,                    # 1 "time step" = 1 turn
            fx=self._state_transition,
            hx=self._observation_model,
            alpha=0.001,               # Sigma point spread — small for near-linear
            beta=2.0,                  # Gaussian prior assumption
            kappa=0.0,
        )
        self.ukf.Q = np.eye(state_dim) * float(settings.UKF_PROCESS_NOISE)
        self.ukf.R = np.eye(state_dim) * float(settings.UKF_OBSERVATION_NOISE)

    def _state_transition(self, x: np.ndarray, dt: float) -> np.ndarray:
        """State transition: assume state persists between turns (identity)."""
        return x

    def _observation_model(self, x: np.ndarray) -> np.ndarray:
        """Observation model: we directly observe all state dimensions."""
        return x

    def initialize(self, first_observation: np.ndarray) -> tuple:
        self.ukf.x = first_observation.copy()
        self.ukf.P = np.eye(self.state_dim) * 1.0  # High initial uncertainty
        return self.ukf.x.copy(), self.ukf.P.copy()

    def update(self, prior_x: np.ndarray, prior_P: np.ndarray,
               observation: np.ndarray) -> tuple:
        """
        Restore UKF state from persistence (prior_x, prior_P).
        Run predict + update cycle.
        Return updated state estimate and covariance.
        """
        self.ukf.x = prior_x.copy()
        self.ukf.P = prior_P.copy()
        self.ukf.predict()
        self.ukf.update(observation)
        return self.ukf.x.copy(), self.ukf.P.copy()
