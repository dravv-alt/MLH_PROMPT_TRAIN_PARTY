def test_raw_text_never_stored_anywhere(client, db):
    """
    Runs full turn pipeline. Queries EVERY table in database.
    If any raw entity or identifying text found: FAIL immediately.
    This is the privacy guarantee. It must hold after every schema change.
    Run this test after: any new model added, any new column added,
    any PWM component modified, any distiller change.
    """
    raw_input = "My boss David criticized me in front of Sarah at our Tuesday standup in London."
    identifiers = ["David", "Sarah", "Tuesday", "London", "standup"]

    response = client.post("/turn", data={"text_input": raw_input,
                                          "session_id": create_test_session(client)})
    assert response.status_code == 200

    for table in [Turn, Entity, Thread, UnsaidNode, NarrativeStateRecord,
                  Session, PrivateLanguageEntry, HypothesisHistory]:
        records = db.query(table).all()
        for record in records:
            record_str = str(record.__dict__)
            for identifier in identifiers:
                assert identifier not in record_str, \
                    f"PII '{identifier}' found in {table.__tablename__}: {record.id}"
