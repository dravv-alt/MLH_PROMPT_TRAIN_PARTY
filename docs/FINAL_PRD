from dataclasses import dataclass, field
from typing import Dict, List
import numpy as np

@dataclass
class RhetoricalStance:
    claim_strength: float = 0.5     # 0.0=no claim, 1.0=full assertion
    self_undermining: float = 0.5   # 0.0=no undermining, 1.0=full invalidation
    # Critical pattern: high claim_strength AND high self_undermining simultaneously
    # = user asserting and immediately invalidating own claim

@dataclass
class NarrativeStateVector:
    """
    Five-dimensional snapshot of user's current narrative position.
    Updated every turn via Unscented Kalman Filter.
    Persisted to SQLite after each turn.
    Used by: Interpretation Engine, Strategy Selector, Bifurcation Proximity.
    NEVER sent to Zone C in any form.
    """
    user_id: str
    session_id: str
    turn_index: int

    # DIMENSION 1: Thread Activation (maps thread_id → score 0.0-1.0)
    thread_activation: Dict[str, float] = field(default_factory=dict)

    # DIMENSION 2: Rhetorical Stance (RST-derived)
    rhetorical_stance: RhetoricalStance = field(default_factory=RhetoricalStance)

    # DIMENSION 3: Depth Layer (1-5, SSM-based)
    # 1=Event Surface, 2=Feeling ID, 3=Pattern Recognition,
    # 4=Belief Encounter, 5=Authorship
    depth_layer: int = 1
    depth_confidence: float = 0.5   # Classifier confidence — only transition if > 0.55

    # DIMENSION 4: Disclosure Entropy (entity-anchored, thread-relative)
    # 0.0 = perfectly predicted by existing thread model
    # 1.0 = completely novel relative to active threads
    disclosure_entropy: float = 0.5
    is_deflection: bool = False     # True if high semantic distance BUT no thread match
                                    # = user avoiding active thread, not genuinely novel

    # DIMENSION 5: Bifurcation Proximity (dynamical systems)
    # 0.0 = stable trajectory, 1.0 = critical point imminent
    bifurcation_proximity: float = 0.0

    # VAD Affective State (this turn)
    vad: VADState = field(default_factory=lambda: VADState(0.0, 0.5, 0.5, 0))

    # UKF uncertainty (covariance matrix P, flattened for storage)
    ukf_uncertainty: List[float] = field(default_factory=list)

    # Companion Fade
    closure_ready_consecutive_turns: int = 0

    def to_numpy(self) -> np.ndarray:
        """Flatten to numpy array for UKF computation."""
        thread_vec = list(self.thread_activation.values()) if self.thread_activation else [0.0]
        return np.array([
            *thread_vec,
            self.rhetorical_stance.claim_strength,
            self.rhetorical_stance.self_undermining,
            float(self.depth_layer),
            self.disclosure_entropy,
            self.bifurcation_proximity,
            self.vad.valence,
            self.vad.arousal,
            self.vad.dominance,
        ], dtype=np.float64)
