    """
    Five competing hypotheses scored via Bayesian update each turn.
    Losing hypotheses decay but persist — can rise again if evidence supports.
    This models how a skilled practitioner actually thinks:
    not committing to one reading, holding multiple, updating continuously.
    """

    DECAY_RATE = 0.85   # Prior score * DECAY_RATE if not reinforced this turn
    NEW_PRIOR = 0.10    # Starting prior for hypothesis not seen last turn

    def run(self, state_vector: NarrativeStateVector, distilled_input: str,
            narrative_structure: NarrativeStructure, placeholder_map: PlaceholderMap,
            prior_hypotheses: List[Hypothesis], user_id: str,
            db: Session) -> List[Hypothesis]:
        """
        For each of five hypotheses:
        1. Compute prior:
             was_active_last_turn → prior = prior_score * DECAY_RATE
             not_seen_last_turn   → prior = NEW_PRIOR
        2. Compute likelihood via hypothesis.compute_likelihood()
        3. Posterior = prior * likelihood (unnormalized)
        4. Normalize all five posteriors to sum to 1.0
        5. Mark highest as is_winner = True
        6. Return all five Hypothesis objects

        Ordering of returned list: descending by score.
