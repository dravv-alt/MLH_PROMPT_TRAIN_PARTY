class ThreadMapManager:
    """
    Maintains the Zettelkasten Shadow Memory: abstract narrative pattern nodes.
    Uses EmbeddingGemma (256-dim) for all embeddings.
    Running centroid update — no full embedding history stored.
    """

    REINFORCE_THRESHOLD = 0.72    # cosine similarity → reinforce existing thread
    NEW_THREAD_THRESHOLD = 0.55   # cosine similarity → all below = new thread
    DECAY_RATE = 0.95             # per-turn decay for non-activated threads
    DORMANT_THRESHOLD = 0.05      # activation_score below = dormant

    def update(self, distilled_input, narrative_structure, placeholder_map,
               user_id, db) -> List[Thread]:
        """
        1. Embed distilled_input via EmbeddingGemma (256-dim)
        2. Load all active/emerging threads for user from SQLite
        3. Compute cosine similarity to each thread centroid
        4. If max_similarity >= REINFORCE_THRESHOLD:
             a. Increase activation_score (cap at 1.0)
             b. Update centroid via running mean
             c. Update last_activated, turn_count
             d. If new session: increment session_count
             e. Update abstract_pattern from narrative_structure
        5. If max_similarity < NEW_THREAD_THRESHOLD (all threads checked):
             a. Create new Thread (status=emerging, activation=0.3)
             b. Set centroid = current embedding
             c. Extract abstract_pattern from narrative_structure DAG
        6. Decay all threads NOT activated this turn:
             activation_score *= DECAY_RATE
             If activation_score < DORMANT_THRESHOLD: status = dormant
        7. Persist all changes
        8. Return list of threads activated this turn
        """
        pass

    def _update_centroid(self, existing: List[float], new_emb: np.ndarray, n: int) -> List[float]:
        """Running mean: c_new = (c_old * n + new_emb) / (n + 1)"""
        existing_arr = np.array(existing)
        return ((existing_arr * n + new_emb) / (n + 1)).tolist()
