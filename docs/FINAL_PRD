### 6.3 VAD Affective State

```python
# backend/core/narrative/vad_tracker.py

from dataclasses import dataclass
from typing import List

@dataclass
class VADState:
    """
    Utterance Emotion Dynamics (UED) framework.
    Three-dimensional affective space.
    Computed per turn from distilled text.
    Tracked as rolling window across session.
    """
    valence: float    # -1.0 (very negative) to +1.0 (very positive)
    arousal: float    # 0.0 (calm) to 1.0 (highly activated)
    dominance: float  # 0.0 (powerless) to 1.0 (in control)
    turn_index: int

@dataclass
class VADTrajectory:
    """Rolling window of VAD states across session."""
    states: List[VADState]
    window_size: int = 5

    @property
    def valence_trend(self) -> float:
        """Positive = improving, negative = declining."""
        if len(self.states) < 2:
            return 0.0
        recent = [s.valence for s in self.states[-self.window_size:]]
        return recent[-1] - recent[0]

    @property
    def arousal_level(self) -> float:
        """Average arousal over window."""
        if not self.states:
            return 0.5
        return sum(s.arousal for s in self.states[-self.window_size:]) / min(len(self.states), self.window_size)

    @property
    def pacing_signal(self) -> str:
        """
        Pacing Engine output. Used by Companion Fade and Strategy Selector.
        Returns: "deepen" | "stabilize" | "pause" | "soften"
        """
        if self.arousal_level > 0.75:
            return "stabilize"
        if self.valence_trend < -0.3:
            return "soften"
        if self.valence_trend > 0.2 and self.arousal_level < 0.4:
            return "deepen"
        return "pause"
