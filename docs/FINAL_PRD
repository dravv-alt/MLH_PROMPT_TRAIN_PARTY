class CompanionFadeEngine:
    """
    Detects when user has reached narrative closure and initiates
    intentional withdrawal of Sanctuary's presence.

    Philosophical basis:
    The greatest risk of AI emotional support is dependency formation.
    Sanctuary is designed to help users process and then step away.
    When a user reaches clarity, the right response is to make space
    for human connection and their own reflection — not to extend.

    Implements Autonomy by Design (Self-Determination Theory):
    Sanctuary acts as a decision-support scaffold, not a social actor.
    When scaffold is no longer needed: withdraw it cleanly.

    This is unique in the emotional AI market.
    Every competitor optimizes for engagement.
    Sanctuary optimizes for completion and disengagement.
    """

    CONSECUTIVE_TURNS_REQUIRED = 3

    CLOSURE_CONDITIONS = {
        "bifurcation_proximity_max": 0.30,    # System stable, not near critical point
        "claim_strength_min": 0.65,           # User speaking with authority
        "self_undermining_max": 0.35,         # User not working against themselves
        "depth_layer_min": 4,                 # User at belief or authorship level
        "entropy_low": True,                  # Familiar, settled territory
    }

    def evaluate(self, state_vector: NarrativeStateVector,
                 prior_consecutive: int) -> dict:
        """
        Check all CLOSURE_CONDITIONS against current state_vector.
        If all met: increment consecutive_turns counter.
        If counter >= CONSECUTIVE_TURNS_REQUIRED: activate fade.

        Returns: {
            "active": bool,
            "consecutive_turns": int,
            "message_hint": str    # For behavioral spec construction
        }
        """
        all_met = (
            state_vector.bifurcation_proximity <= self.CLOSURE_CONDITIONS["bifurcation_proximity_max"]
            and state_vector.rhetorical_stance.claim_strength >= self.CLOSURE_CONDITIONS["claim_strength_min"]
            and state_vector.rhetorical_stance.self_undermining <= self.CLOSURE_CONDITIONS["self_undermining_max"]
            and state_vector.depth_layer >= self.CLOSURE_CONDITIONS["depth_layer_min"]
            and not state_vector.is_deflection
        )

        consecutive = (prior_consecutive + 1) if all_met else 0
        active = consecutive >= self.CONSECUTIVE_TURNS_REQUIRED

        return {
            "active": active,
            "consecutive_turns": consecutive,
            "message_hint": "closure_ready" if active else "building"
        }
