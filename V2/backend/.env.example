GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_TOKENS=220
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=220
SPACY_MODEL=en_core_web_sm
ENVIRONMENT=local
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://127.0.0.1:8000
SANCTUARY_DATABASE_URL=
SANCTUARY_SQLITE_PATH=
SANCTUARY_ALIAS_KEY=
# Leave blank to create a local persistent key in data/.nlp_alias_key.
DMRST_MODEL_PATH=
DMRST_BACKBONE_PATH=
# New local neural workers: CPU threads per process (use 1 in deterministic tests).
SANCTUARY_NEURAL_THREADS=2
# Generation stays local by default. Hosted requires both values below and an
# explicitly configured provider callable; no automatic network fallback exists.
SANCTUARY_GENERATION_PROVIDER=local
SANCTUARY_HOSTED_GENERATION_OPT_IN=false
# Optional UI-selected hosted mode uses Groq only after explicit request consent.
SANCTUARY_HOSTED_MODEL=openai/gpt-oss-20b
