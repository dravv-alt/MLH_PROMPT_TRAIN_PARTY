class BifurcationProximityComputer:
    """
    Detects proximity to narrative critical point (bifurcation).
    Uses dynamical systems theory: critical slowing down signatures.

    Before a qualitative shift in a nonlinear dynamical system:
    - Variance of recent states increases (system fluctuating widely)
    - Lag-1 autocorrelation increases (system slowing, not settling)
    Both simultaneously = critical slowing down = bifurcation approaching.

    This detects: user hovering near a genuine inner shift.
    At this moment: one precise response matters more than many.
    Strategy: BIFURCATION_PRESENCE (one sentence, maximum space).
    """

    MIN_HISTORY = 5           # Minimum state vectors before computation is valid
    WINDOW = 10               # State vectors to analyze
    THRESHOLD = 0.75          # proximity > this = bifurcation imminent

    def compute(self, user_id: str, db: Session) -> float:
        """
        1. Retrieve last WINDOW NarrativeStateRecord vectors for user
           (across sessions — trajectory is continuous across sessions)
        2. If fewer than MIN_HISTORY: return 0.0 (insufficient data)
        3. Stack to numpy array: shape (n_turns, state_dim)
        4. Compute variance across last n states:
              variance = np.var(state_matrix, axis=0).mean()
              normalized_variance = min(variance / 0.5, 1.0)
        5. Compute lag-1 autocorrelation of mean-state trajectory:
              traj = state_matrix.mean(axis=1)  # scalar per turn
              autocorr = np.corrcoef(traj[:-1], traj[1:])[0, 1]
              normalized_autocorr = max(0.0, autocorr)  # clip negative
        6. proximity = 0.5 * normalized_variance + 0.5 * normalized_autocorr
        7. Return min(proximity, 1.0)
        """
