class PrivacyDistiller:
    """
    PII stripping and placeholder mapping.
    Must run BEFORE any other processing.
    Raw text must never reach any other component without distillation.
    """

    PLACEHOLDER_PREFIXES = {
        "PERSON": "PERSON",
        "GPE": "LOCATION",
        "LOC": "LOCATION",
        "ORG": "ORG",
        "DATE": "TIME",
        "TIME": "TIME",
        "EVENT": "EVENT",
    }

    def distill(self, raw_text: str, user_id: str, db: Session) -> PlaceholderMap:
        """
        Step 1: Run spaCy NER on raw_text.
        Step 2: For each detected entity:
            a. Call CoreferenceResolver.resolve() → check if maps to existing entity
            b. If match found (confidence >= 0.75): use existing placeholder_id
            c. If no match: assign next available (PERSON_A, PERSON_B, etc.)
            d. Update reverse_map and entity_map
        Step 3: Replace all entity spans in text with placeholder IDs
        Step 4: Regex strip: email patterns, phone patterns, URLs
        Step 5: Return PlaceholderMap. Do NOT persist. Do NOT log raw_text.

        Output guarantee: distilled_text contains zero PII.
        Verify: no surface_form from entity_map appears in distilled_text.
        """
        pass
