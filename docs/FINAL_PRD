        ["python", "scripts/start_dmrst_server.py"],
        cwd=str(settings.DMRST_MODEL_PATH)
    )
    # Wait for DMRST server ready (poll localhost:5050 health endpoint)

    # Load depth classifier if Phase 3 pkl exists
    depth_pkl = Path("data/depth_labels/depth_classifier.pkl")
