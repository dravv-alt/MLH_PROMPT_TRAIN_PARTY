class DisclosureEntropyComputer:
    """
    Entity-anchored, thread-relative entropy.
    NOT flat session-to-session semantic distance.

    Key distinction (from brutal critique analysis):
    Flat semantic distance cannot distinguish:
    - Genuine novelty (new territory within active thread) → HIGH entropy
    - Deflection (switching topic away from active thread) → DEFLECTION flag

    This computer disambiguates by anchoring entropy to active threads.
    """

    DEFLECTION_MAX_SIMILARITY = 0.35   # All active threads below this = deflection
    HIGH_ENTROPY_MIN = 0.70
    LOW_ENTROPY_MAX = 0.30

    def compute(self, distilled_input: str, user_id: str,
                db: Session) -> tuple[float, bool]:
        """
        Returns: (entropy_score: float, is_deflection: bool)

        1. Embed distilled_input via EmbeddingGemma (256-dim)
        2. Retrieve all active threads (activation_score > 0.3) for user
        3. If no active threads: return (0.8, False) — new user, everything novel
        4. Compute cosine similarity to each active thread centroid
        5. max_similarity = max across all active thread similarities
        6. entropy = 1.0 - max_similarity  (0.0=familiar, 1.0=novel)
        7. Deflection check:
              if max_similarity < DEFLECTION_MAX_SIMILARITY
              AND user has active threads (step 2 returned threads)
              → is_deflection = True (user pivoting away, not genuinely novel)
        8. Return (entropy, is_deflection)
        """
